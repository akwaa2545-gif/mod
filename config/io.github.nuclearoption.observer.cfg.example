# Example only: keep the existing runtime config when updating from 0.1.1.
# 0.5.1 EXPERIMENTAL preserves existing PiP Enabled=true; FlightHold defaults OFF. Automatic own-launch viewing is a separate opt-in.
# Runtime config lives in BepInEx/config/io.github.nuclearoption.observer.cfg.
[PiP]
Enabled = false

[Manual]
Schema = 2

[Window]
X = 16
Y = 16
Width = 480
Scale = 1

# Unity KeyCode integers: F1=282 ... F12=293; distinct, no modifiers.
# Defaults F8/F9/F10. Check native and other-mod bindings for conflicts.
[Keys]
Panel = 289
# Toggle PiP open/close during safe gameplay or the paused Observer menu.
View = 290
# Manual Next missile during safe gameplay or the paused Observer menu.
Next = 291
Fullscreen = 292
ResetOrbit = 288

[MissileCamera]
# False preserves manual behavior; true affects only future NEW own-aircraft launches.
AutoShowOwnLaunch = false

[FlightHold]
# EXPERIMENTAL / NOT GAME TESTED. No target speed/height input: capture current values.
Enabled = false
# Effective only while hold is ACTIVE. OFF keeps ordinary hold, no avoidance climb.
TerrainAvoidance = true
ManualOverrideDeadband = 0.15
