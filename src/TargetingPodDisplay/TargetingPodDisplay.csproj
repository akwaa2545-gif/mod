<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>TargetingPodDisplay</AssemblyName>
    <Version>0.1.1</Version>
    <GameRefs Condition="'$(GameRefs)' == ''">$(MSBuildThisFileDirectory)../../private/refs</GameRefs>
    <LoaderRefs Condition="'$(LoaderRefs)' == ''">/workspace/shared/nuclear-option-tools/bepinex-5.4.23.5/core</LoaderRefs>
  </PropertyGroup>
  <!-- Explicit offline-provided graph only. Do not auto-resolve unrelated transitive Unity/system DLLs. -->
  <ItemDefinitionGroup><Reference><ExternallyResolved>true</ExternallyResolved></Reference></ItemDefinitionGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameRefs)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirage"><HintPath>$(GameRefs)/Mirage.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameRefs)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameRefs)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameRefs)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(GameRefs)/Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(GameRefs)/Unity.RenderPipelines.Universal.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameRefs)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameRefs)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameRefs)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameRefs)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Rewired_Core"><HintPath>$(GameRefs)/Rewired_Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(LoaderRefs)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LoaderRefs)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
